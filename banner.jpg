ark-coast.jpg?w=374&amp;h=249, https://i.natgeofe.com/n/ff0afd02-2a33-4d6e-9e9c-6c66f1817b8d/isle-royale-national-park-coast.jpg?w=748&amp;h=498 2x"/><source media="(min-width: 375px) and (max-width: 413px)" srcSet="https://i.natgeofe.com/n/ff0afd02-2a33-4d6e-9e9c-6c66f1817b8d/isle-royale-national-park-coast.jpg?w=413&amp;h=275, https://i.natgeofe.com/n/ff0afd02-2a33-4d6e-9e9c-6c66f1817b8d/isle-royale-national-park-coast.jpg?w=826&amp;h=550 2x"/><source media="(min-width: 414px) and (max-width: 767px)" srcSet="https://i.natgeofe.com/n/ff0afd02-2a33-4d6e-9e9c-6c66f1817b8d/isle-royale-national-park-coast.jpg?w=767&amp;h=511, https://i.natgeofe.com/n/ff0afd02-2a33-4d6e-9e9c-6c66f1817b8d/isle-royale-national-park-coast.jpg?w=1534&amp;h=1022 2x"/><source media="(min-width: 768px) and (max-width: 1024px)" srcSet="https://i.natgeofe.com/n/ff0afd02-2a33-4d6e-9e9c-6c66f1817b8d/isle-royale-national-park-coast.jpg?w=1024&amp;h=683, https://i.natgeofe.com/n/ff0afd02-2a33-4d6e-9e9c-6c66f1817b8d/isle-royale-national-park-coast.jpg?w=2048&amp;h=1366 2x"/><source media="(min-width: 1025px) and (max-width: 1440px)" srcSet="https://i.natgeofe.com/n/ff0afd02-2a33-4d6e-9e9c-6c66f1817b8d/isle-royale-national-park-coast.jpg?w=1440&amp;h=960&amp;q=90, https://i.natgeofe.com/n/ff0afd02-2a33-4d6e-9e9c-6c66f1817b8d/isle-royale-national-park-coast.jpg?w=2880&amp;h=1920&amp;q=90 2x"/><source media="(min-width: 1441px) and (max-width: 1920px)" srcSet="https://i.natgeofe.com/n/ff0afd02-2a33-4d6e-9e9c-6c66f1817b8d/isle-royale-national-park-coast.jpg?w=1920&amp;h=1280&amp;q=90, https://i.natgeofe.com/n/ff0afd02-2a33-4d6e-9e9c-6c66f1817b8d/isle-royale-national-park-coast.jpg?w=3840&amp;h=2560&amp;q=90 2x"/><source media="(min-width: 1921px)" srcSet="https://i.natgeofe.com/n/ff0afd02-2a33-4d6e-9e9c-6c66f1817b8d/isle-royale-national-park-coast.jpg?w=2500&amp;h=1667&amp;q=90, https://i.natgeofe.com/n/ff0afd02-2a33-4d6e-9e9c-6c66f1817b8d/isle-royale-national-park-coast.jpg?w=5000&amp;h=3334&amp;q=90 2x