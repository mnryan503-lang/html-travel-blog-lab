anel":true,"textPosition":{"x":"left","y":"center"},"cmsType":"ImmersiveLeadTile","cmsImage":{"cmsType":"image","hasCopyright":true,"id":"afed9877-feea-4292-bbc0-d049bab77277","lines":3,"positionMetaBottom":true,"showMore":true,"caption":"North Cascades National Park, Washington","credit":"Photograph by Jonathan Irish","image":{"crps":[{"nm":"raw","aspRto":1.5,"url":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg"},{"nm":"16x9","aspRto":1.7777777777777777,"url":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan_16x9.jpg"},{"nm":"3x2","aspRto":1.5,"url":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan_3x2.jpg"},{"nm":"square","aspRto":1,"url":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan_square.jpg"},{"nm":"2x3","aspRto":0.6666666666666666,"url":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan_2x3.jpg"},{"nm":"3x4","aspRto":0.75,"url":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan_3x4.jpg"},{"nm":"4x3","aspRto":1.3333333333333333,"url":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan_4x3.jpg"},{"nm":"2x1","aspRto":2,"url":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan_2x1.jpg"}],"rt":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg","src":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg","altText":"Picture Lake and Mount Shuksan in North Cascades National Park, Washington","crdt":"Photograph by Jonathan Irish","dsc":"My favorite place to photograph is from the aptly named Picture Lake, which has impressive views of Mount Shuksan. This is an easily accessed lake that is best photographed during sunset.","ttl":"North Cascades National Park"},"imageAlt":"Picture Lake and Mount Shuksan in North Cascades National Park, Washington"},"hideEndBug":true,"positionMetaBottom":true,"showDownArrow":false,"ctaLinkDisplay":"textLink","description":"From massive glaciers to sun-soaked beaches, national parks offer some of America’s wildest and most iconic landscapes.","sectionLabels":[{"name":"Travel","type":"sources","uri":"https://www.nationalgeographic.com/travel"}],"theme":"dark","tint":"noTint","title":"See the beauty of all 63 U.S. national parks, in photos","imageSrcLead":[{"sources":{"x1":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=374&h=249","x2":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=748&h=498"},"media":"(max-width: 374px)"},{"sources":{"x1":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=413&h=275","x2":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=826&h=550"},"media":"(max-width: 413px)"},{"sources":{"x1":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=767&h=511","x2":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=1534&h=1022"},"media":"(max-width: 767px)"},{"sources":{"x1":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=1024&h=683","x2":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=2048&h=1366"},"media":"(max-width: 1024px)"},{"sources":{"x1":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=1260&h=840","x2":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=2520&h=1680"},"media":"(max-width: 1440px)"},{"sources":{"x1":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=1440&h=960","x2":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=2880&h=1920"},"media":"(min-width: 1441px)"}],"imageSrc":[{"sources":{"x1":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan_2x3.jpg?w=374&h=561","x2":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan_2x3.jpg?w=748&h=1122"},"media":"(max-width: 374px)"},{"sources":{"x1":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan_2x3.jpg?w=413&h=620","x2":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan_2x3.jpg?w=826&h=1240"},"media":"(max-width: 413px)"},{"sources":{"x1":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan_2x3.jpg?w=767&h=1151","x2":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan_2x3.jpg?w=1534&h=2302"},"media":"(max-width: 767px)"},{"sources":{"x1":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=1024&h=683","x2":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=2048&h=1366"},"media":"(max-width: 1024px)"},{"sources":{"x1":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=1260&h=840","x2":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=2520&h=1680"},"media":"(max-width: 1440px)"},{"sources":{"x1":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=1440&h=960","x2":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan.jpg?w=2880&h=1920"},"media":"(min-width: 1441px)"}]}]},{"id":"natgeo-template1-frame-1-module-1","cmsType":"StackModule","align":"left","edgs":[{"dvdr":{"hideLogo":true},"cmsType":"ArticleBodyTile","id":"natgeo-template1-frame-1-module-1","bdy":[{"id":"html0","cntnt":{"mrkup":"When the U.S. Congress established <a href=\"https://www.nationalgeographic.com/travel/article/see-yellowstone-in-iconic-nat-geo-images\" target=\"_blank\" dir=\"ltr\">Yellowstone<\/a> as the first national park in 1872, it was “for the benefit and enjoyment of the people.” Its founding marked the birth of the U.S. National Park System and eventually launched a worldwide movement to protect outdoor spaces and historical landmarks. Since 1904, some <a href=\"https://www.nps.gov/aboutus/visitation-numbers.htm\" target=\"_blank\" dir=\"ltr\">15 billion visitors<\/a> have explored the wild wonders of the U.S. parks."},"type":"p","style":{}},{"id":"html1","cntnt":{"mrkup":"Inspired by the National Park Service, photographer <a href=\"https://www.jonathanirish.com/index/G0000S6QPk7.Al_c\" target=\"_blank\" dir=\"ltr\">Jonathan Irish<\/a> inspired by the visited every <a href=\"https://www.nationalgeographic.com/travel/national-parks/\" target=\"_blank\" dir=\"ltr\">U.S. national park<\/a> over 52 weeks."},"type":"p","style":{}},{"id":"html2","cntnt":{"mrkup":"“[National parks] are sacred and cherished places—our greatest personal and national treasures,” says Irish. “It’s a gift to spend a year adventuring and capturing incredible images and stories in some of the most beautiful places on Earth.”"},"type":"p","style":{}},{"id":"html3","cntnt":{"mrkup":"Since Irish’s journey, the National Parks Service has designated four additional parks: the Gateway Arch in St. Louis; Indiana Dunes on Lake Michigan; White Sands in New Mexico; and New River Gorge in West Virginia. There are now 63 spaces to explore across the country."},"type":"p","style":{}},{"id":"html4","cntnt":{"mrkup":"Celebrate the grandeur of these priceless national treasures in images, from the crystalline waters of Dry Tortugas in Florida to the deep, dark recesses of Kentucky’s Mammoth Cave."},"type":"p","style":{}},{"id":"html5","cntnt":{"mrkup":"1.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/zion-national-park\" target=\"_blank\" dir=\"ltr\">Zion National Park<\/a>, Utah"},"type":"h2","style":{}},{"id":"42c1db63-9c4a-4204-be0f-b877f3ea931d","cntnt":{"cmsType":"image","ariaLabel":"image","align":"contentWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html6","cntnt":{"mrkup":"&nbsp;One of the most photographed views in&nbsp;Zion National Park&nbsp;is of Watchman Mountain from the Canyon Junction Bridge. Irish’s favorite spot is at the center of the bridge where the river leads the eye to the Watchman Spire in the background."},"type":"p","style":{}},{"id":"html7","cntnt":{"mrkup":"2.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/yellowstone-national-park\" target=\"_blank\" dir=\"ltr\">Yellowstone National Park,<\/a>&nbsp;Wyoming, Montana, and Idaho"},"type":"h2","style":{}},{"id":"275e238d-b080-4ecc-b2e1-9ad8af67f015","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html8","cntnt":{"mrkup":"America’s first national park,&nbsp;Yellowstone&nbsp;is home to wildlife from bears to bison and geological stunners such as hot springs and geysers. The Great Fountain Geyser, pictured here, erupts every 9 to 15 hours, shooting water up to 220 feet (67 meters) high."},"type":"p","style":{}},{"id":"html9","cntnt":{"mrkup":"3.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/acadia-national-park\" target=\"_blank\" dir=\"ltr\">Acadia National Park<\/a>, Maine"},"type":"h2","style":{}},{"id":"36891106-e205-48c1-8e12-e4fc1e2ba5d7","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html10","cntnt":{"mrkup":"Avoid the crowds at Cadillac Mountain and see the first sunrise in the country at Bass Harbor Head Lighthouse, in the southwest portion of Acadia National Park. Bikers looking for the best trails in the park should consider <a href=\"https://www.nationalgeographic.com/travel/article/carriage-roads-acadia-national-park-maine\" target=\"_blank\" dir=\"ltr\">these trails<\/a>, once carriage roads."},"type":"p","style":{}},{"id":"html11","cntnt":{"mrkup":"4.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/yosemite-national-park\" target=\"_blank\" dir=\"ltr\">Yosemite National Park<\/a>, California"},"type":"h2","style":{}},{"id":"b6b37852-6e77-4336-b88b-b95c6e2051b5","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html12","cntnt":{"mrkup":"Irish says the best time to see a rainbow in&nbsp;Yosemite&nbsp;is at night during a full moon. To photograph these so-called moonbows, he recommends a wide-angle lens, a tripod, and a lens cloth (to continually wipe off the waterfall spray). Visitors may want to consider <a href=\"https://www.nationalgeographic.com/travel/article/best-places-to-stay-yosemite-national-park\" target=\"_blank\" dir=\"ltr\">staying at these 10 places<\/a> when visiting the park."},"type":"p","style":{}},{"id":"html13","cntnt":{"mrkup":"5.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/sequoia-kings-canyon-national-park\" target=\"_blank\" dir=\"ltr\">Sequoia National Park<\/a>, California"},"type":"h2","style":{}},{"id":"962f019c-5409-499a-8f64-6eb2b47deefa","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html14","cntnt":{"mrkup":"Nestled in California’s Sierra Nevada mountains,&nbsp;Sequoia National Park&nbsp;is nearly 97 percent wilderness. It holds over 2,000 giant sequoia trees, including General Sherman Tree, the world’s largest tree, measured by volume.&nbsp;"},"type":"p","style":{}},{"id":"html15","cntnt":{"mrkup":"6.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/crater-lake-national-park\" target=\"_blank\" dir=\"ltr\">Crater Lake National Park<\/a>, Oregon"},"type":"h2","style":{}},{"id":"31ca37f9-f171-4cf7-b85e-5b58fa9c1d8a","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html16","cntnt":{"mrkup":"Wizard Island, named for its resemblance to a sorcerer’s hat, juts into Crater Lake, the deepest lake in the U.S. The lake, which measures 1,943 feet in some spots, lends the&nbsp;park its name.&nbsp;"},"type":"p","style":{}},{"id":"html17","cntnt":{"mrkup":"7.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/grand-canyon-national-park\" target=\"_blank\" dir=\"ltr\">Grand Canyon National Park<\/a>, Arizona"},"type":"h2","style":{}},{"id":"eb9d42f8-c8d7-46e8-89cd-6cd50d41ce3f","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html18","cntnt":{"mrkup":"The Grand Canyon National Park is a sprawling gorge of layers in pink, red, and orange hues, revealing millions of years of geological history.&nbsp;"},"type":"p","style":{}},{"id":"html19","cntnt":{"mrkup":"8.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/great-smoky-mountains-national-park\" target=\"_blank\" dir=\"ltr\">Great Smoky Mountains National Park<\/a>, Tennessee"},"type":"h2","style":{}},{"id":"157c9b55-8075-4a30-9226-b064530d9c6c","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html20","cntnt":{"mrkup":"Fog lingers among the forested hills of&nbsp;Great Smoky Mountains National Park, which spans the southern Appalachians along the border between Tennessee and North Carolina. Water and hydrocarbons exuded by trees produce the filmy “smoke” that gives the mountains their name."},"type":"p","style":{}},{"id":"html21","cntnt":{"mrkup":"9.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/death-valley-national-park\" target=\"_blank\" dir=\"ltr\">Death Valley National Park<\/a>, Nevada"},"type":"h2","style":{}},{"id":"b0f611a5-f058-4222-90be-276ee5aeb1fa","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html22","cntnt":{"mrkup":"The largest national park south of Alaska,&nbsp;Death Valley National Park&nbsp;is known for extremes: It is North America’s driest and hottest spot (with fewer than two inches/five centimeters of rainfall annually and a record high of 134°F), and has the lowest elevation on the continent—282 feet below sea level."},"type":"p","style":{}},{"id":"html23","cntnt":{"mrkup":"10.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/redwood-national-park\" target=\"_blank\" dir=\"ltr\">Redwood National Park<\/a>, California"},"type":"h2","style":{}},{"id":"a84a9cd4-36ae-48e9-b88f-bbccce5226d8","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html24","cntnt":{"mrkup":"When author John Steinbeck stood in the presence of redwood trees—the tallest living things on the planet—he described the sensation as a “cathedral hush.” Among the trees preserved in&nbsp;Redwood National Park&nbsp;are the oldest, largest, and tallest of coast redwoods.&nbsp;"},"type":"p","style":{}},{"id":"html25","cntnt":{"mrkup":"11.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/olympic-national-park\" target=\"_blank\" dir=\"ltr\">Olympic National Park<\/a>, Washington"},"type":"h2","style":{}},{"id":"ae4b5296-2cb6-4d96-b207-a9cd4d5dd3f7","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html26","cntnt":{"mrkup":"Olympic National Park’s 73 miles of park coastline feature soaring cliffs, sea stacks, sandy beaches, rocky shores, and teeming tide pools.&nbsp;"},"type":"p","style":{}},{"id":"html27","cntnt":{"mrkup":"12.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/grand-teton-national-park\" target=\"_blank\" dir=\"ltr\">Grand Teton National Park<\/a>, Wyoming"},"type":"h2","style":{}},{"id":"e8453c40-ba15-4f0a-a371-4c37e0adb9e7","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html28","cntnt":{"mrkup":"Schwabacher Landing and Snake River, made famous by Ansel Adams, draw photographers and nature lovers to&nbsp;Grand Teton National Park. The park’s jewel-like lakes, blue and white glaciers, and naked granite pinnacles enticed more than 3.5 million visitors in 2024.&nbsp;"},"type":"p","style":{}},{"id":"html29","cntnt":{"mrkup":"13.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/everglades-national-park-1\" target=\"_blank\" dir=\"ltr\">Everglades National Park<\/a>, Florida"},"type":"h2","style":{}},{"id":"25619983-a6c8-46d0-902a-e4472e2c1946","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html30","cntnt":{"mrkup":"Sprawling between South Florida’s Lake Okeechobee and the Gulf of Mexico, the&nbsp;Everglades&nbsp;is one of the world’s largest tropical wetlands and the third-largest national park in the lower 48 states."},"type":"p","style":{}},{"id":"html31","cntnt":{"mrkup":"14.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/big-bend-national-park-1\" target=\"_blank\" dir=\"ltr\">Big Bend National Park<\/a>, Texas"},"type":"h2","style":{}},{"id":"a8e331fa-26aa-486b-9dd1-09f2a321c7ea","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html32","cntnt":{"mrkup":"Recently named the world’s largest International Dark Sky Reserve,&nbsp;Big Bend National Park’s hundred-mile views sweep across the hills, arroyos, and mesas of West Texas’ Chihuahuan Desert."},"type":"p","style":{}},{"id":"html33","cntnt":{"mrkup":"15.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/joshua-tree-national-park\" target=\"_blank\" dir=\"ltr\">Joshua Tree National Park<\/a>, California"},"type":"h2","style":{}},{"id":"18f189f0-042b-4b7c-aa5b-0dd77ff998e2","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html34","cntnt":{"mrkup":"At&nbsp;Joshua Tree National Park&nbsp;in California’s Mojave Desert, these tough, gnarled plants are threatened by climate change.&nbsp;&nbsp;"},"type":"p","style":{}},{"id":"html35","cntnt":{"mrkup":"16.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/bryce-canyon-national-park\" target=\"_blank\" dir=\"ltr\">Bryce Canyon National Park<\/a>, Utah"},"type":"h2","style":{}},{"id":"c9da2f24-1d1e-430d-bf15-f151da4f6391","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html36","cntnt":{"mrkup":"Bryce Canyon National Park, in southern Utah, draws more than 2.7 million visitors a year, thanks to its stunning geology of red arches and phantom-like spires, called hoodoos."},"type":"p","style":{}},{"id":"html37","cntnt":{"mrkup":"17.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/arches-national-park\" target=\"_blank\" dir=\"ltr\">Arches National Park,<\/a>&nbsp;Utah&nbsp;"},"type":"h2","style":{}},{"id":"585b0e71-f367-47f5-a005-6ced86f37894","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html38","cntnt":{"mrkup":"With over 2,000 natural stone arches,&nbsp;Arches National Park&nbsp;is part of southern Utah’s extended canyon country, carved and shaped by weathering and erosion.&nbsp;"},"type":"p","style":{}},{"id":"html39","cntnt":{"mrkup":"18.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/great-sand-dunes-national-park\" target=\"_blank\" dir=\"ltr\">Grand Sand Dunes National Park<\/a>, Colorado"},"type":"h2","style":{}},{"id":"0858c946-42d2-4472-8946-a1c6b3f4d4ea","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html40","cntnt":{"mrkup":"Great Sand Dunes National Park, which contains the highest sand dunes in North America, provides stunning views in the shadow of the majestic Sangre de Cristo Mountains."},"type":"p","style":{}},{"id":"html41","cntnt":{"mrkup":"19. Dry Tortugas National Park, Florida"},"type":"h2","style":{}},{"id":"49af65ff-7fc0-486d-85ea-909084a921a8","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html42","cntnt":{"mrkup":"Dry Tortugas National Park, located 70 miles west of Key West in the Gulf of Mexico, houses the 19th-century Fort Jefferson, pictured here. The park is also home to the third-largest coral barrier reef in the world and the only tropical reef in the continental U.S."},"type":"p","style":{}},{"id":"html43","cntnt":{"mrkup":"20.&nbsp;<a href=\"https://www.nps.gov/maca/index.htm\" target=\"_blank\" dir=\"ltr\">Mammoth Cave National Park<\/a>, Kentucky"},"type":"h2","style":{}},{"id":"cae295ed-42ac-4114-9d86-62c096e54910","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html44","cntnt":{"mrkup":"Hidden under hills and hollows in Kentucky,&nbsp;Mammoth Cave National Park&nbsp;contains more than 400 miles of caves, including 10 miles of passages for guided tours.&nbsp;"},"type":"p","style":{}},{"id":"html45","cntnt":{"mrkup":"21.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/petrified-forest-national-park\" target=\"_blank\" dir=\"ltr\">Petrified Forest National Park<\/a>, Arizona"},"type":"h2","style":{}},{"id":"08c1606a-8928-4215-8df2-d60e036970fd","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html46","cntnt":{"mrkup":"Walking along the&nbsp;park’s trails, visitors can see hills made of bluish clay and the largest concentration of brilliantly colored petrified wood in the U.S."},"type":"p","style":{}},{"id":"html47","cntnt":{"mrkup":"22.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/article/biscayne-national-park-1\" target=\"_blank\" dir=\"ltr\">Biscayne National Park<\/a>, Florida"},"type":"h2","style":{}},{"id":"18d96fdf-6ab9-4852-b77f-db850a6e392f","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html48","cntnt":{"mrkup":"Just five miles from the heart of downtown Miami,&nbsp;Biscayne National Park&nbsp;protects the northern end of the Florida Reef, the longest stretch of mangrove forest on Florida’s east coast, the southern part of Biscayne Bay, and 50 islands of the northern Florida Keys in the Atlantic Ocean.&nbsp;"},"type":"p","style":{}},{"id":"html49","cntnt":{"mrkup":"23.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/mount-rainier-national-park\" target=\"_blank\" dir=\"ltr\">Mount Rainier National Park<\/a>, Washington"},"type":"h2","style":{}},{"id":"43228430-7d6d-4481-a6c6-34a1915f5241","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html50","cntnt":{"mrkup":"One of the world’s oldest national parks,&nbsp;Mount Rainier&nbsp;became part of the federal system in 1899, shortly after its last eruption. It remains one of the most dangerous volcanoes in the world.&nbsp;"},"type":"p","style":{}},{"id":"html51","cntnt":{"mrkup":"24.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/virgin-islands-national-park\" target=\"_blank\" dir=\"ltr\">Virgin Islands National Park<\/a>, St. John"},"type":"h2","style":{}},{"id":"8ee11466-dff1-43bd-97ca-22fa2074507a","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html52","cntnt":{"mrkup":"This&nbsp;pristine tropical reserve—covering almost two-thirds of St. John, plus 5,650 acres underwater—features a coral reef, more than 800 subtropical plant species, and crystalline Caribbean waters.&nbsp;"},"type":"p","style":{}},{"id":"html53","cntnt":{"mrkup":"25.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/shenandoah-national-park\" target=\"_blank\" dir=\"ltr\">Shenandoah National Park<\/a>, Virginia"},"type":"h2","style":{}},{"id":"c3a51c66-e082-494d-ba46-5250f31cc77c","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html54","cntnt":{"mrkup":"Located between the Shenandoah Valley in the west and the Piedmont region in the east,&nbsp;the park&nbsp;is an expanse of wooden hollows and breezy summits, waterfalls and mountain streams, more than 500 miles of hiking trails, and nearly 80,000 acres of designated wilderness—all just 75 miles from Washington, D.C."},"type":"p","style":{}},{"id":"html55","cntnt":{"mrkup":"26.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/carlsbad-caverns-national-park\" target=\"_blank\" dir=\"ltr\">Carlsbad Caverns National Park<\/a>, New Mexico"},"type":"h2","style":{}},{"id":"b8d86a41-0d3a-4313-be55-86e6d2f7c7a0","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html56","cntnt":{"mrkup":"More than 119 caves are hidden beneath the surface of&nbsp;this national park&nbsp;in the Chihuahuan Desert. Cave scientists have explored at least 30 miles of passageways of the main cavern of Carlsbad, and the investigation continues. Visitors may tour three of these miles on a paved trail.&nbsp;"},"type":"p","style":{}},{"id":"html57","cntnt":{"mrkup":"27.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/cuyahoga-valley-national-park\" target=\"_blank\" dir=\"ltr\">Cuyahoga Valley National Park<\/a>, Ohio"},"type":"h2","style":{}},{"id":"10961a09-b5e0-4a0c-8c5e-2cc654e057a4","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html58","cntnt":{"mrkup":"North of Hale Farm is&nbsp;Cuyahoga Valley’s Everett Covered Bridge, a reconstruction of an 1870s structure that was destroyed in a 1975 flood. Irish says he enjoyed walking over the old bridge while imagining the hoof taps and footsteps that once echoed over the wooden planks."},"type":"p","style":{}},{"id":"html59","cntnt":{"mrkup":"28.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/guadalupe-mountains-national-park\" target=\"_blank\" dir=\"ltr\">Guadalupe Mountains National Park<\/a>, Texas"},"type":"h2","style":{}},{"id":"76cd4329-5fc5-429c-aefc-a395e69b9362","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html60","cntnt":{"mrkup":"Dramatically contoured canyons, sprawling desert scrub brush, and a profusion of wildlife and birds fill West Texas’&nbsp;Guadalupe Mountains National Park.&nbsp;"},"type":"p","style":{}},{"id":"html61","cntnt":{"mrkup":"29.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/congaree-national-park\" target=\"_blank\" dir=\"ltr\">Congaree National Park<\/a>, South Carolina"},"type":"h2","style":{}},{"id":"938fe9f1-3a17-40a5-b007-cc309b5de3bd","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html62","cntnt":{"mrkup":"Congaree National Park&nbsp;contains the largest intact tract of old-growth bottomland forest in North America. Boardwalk hikes and canoe tours are popular activities among the towering trees."},"type":"p","style":{}},{"id":"html63","cntnt":{"mrkup":"(<a href=\"https://www.nationalgeographic.com/travel/article/least-visited-national-parks\" target=\"_blank\" dir=\"ltr\"><i>Avoid crowds at the 10 least-visited U.S. national parks<\/i><\/a>)"},"type":"p","style":{}},{"id":"html64","cntnt":{"mrkup":"30.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/article/saguaro-national-park-offers-so-much-more-than-famous-cacti\" target=\"_blank\" dir=\"ltr\">Saguaro National Park<\/a>, Arizona&nbsp;"},"type":"h2","style":{}},{"id":"28fdf0d5-642d-4c7b-86af-3d50a4c3867f","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html65","cntnt":{"mrkup":"Saguaro National Park&nbsp;takes its name from the largest cacti in the United States. The park, which flanks Tucson, is home to millions of the cacti, which can grow up to 50 feet tall.&nbsp;"},"type":"p","style":{}},{"id":"html66","cntnt":{"mrkup":"31. <a href=\"https://www.nationalgeographic.com/travel/national-parks/article/sequoia-kings-canyon-national-park\" target=\"_blank\" dir=\"ltr\">Kings Canyon National Park<\/a>, California"},"type":"h2","style":{}},{"id":"3efe3210-12e6-489b-add9-71c061d3af63","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html67","cntnt":{"mrkup":"Hiking into Paradise Valley offers some of the best views in&nbsp;Kings Canyon National Park. Irish backpacked into the valley and spent the night along the river. He says it was one of the most peaceful and beautiful camping spots of his trip."},"type":"p","style":{}},{"id":"html68","cntnt":{"mrkup":"32.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/great-basin-national-park\" target=\"_blank\" dir=\"ltr\">Great Basin National Park<\/a>, Nevada"},"type":"h2","style":{}},{"id":"00964c14-8887-42f8-aa44-7f6f17f4281c","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html69","cntnt":{"mrkup":"Great Basin National Park’s Wheeler Peak, at just over 13,000 feet high, is home to a large grove of bristlecone pine trees, some of the world’s oldest trees."},"type":"p","style":{}},{"id":"html70","cntnt":{"mrkup":"33.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/isle-royale-national-park\" target=\"_blank\" dir=\"ltr\">Isle Royale National Park<\/a>, Michigan"},"type":"h2","style":{}},{"id":"65579646-3808-45b0-ba3e-71ab8b1b9c00","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html71","cntnt":{"mrkup":"Seasoned backpackers, kayakers, and canoeists often arrive (via hours-long ferry rides or seaplane) equipped to navigate the&nbsp;park’s roadless backcountry&nbsp;and inland lake paddling route, Chain of Lakes."},"type":"p","style":{}},{"id":"html72","cntnt":{"mrkup":"34.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/article/more-than-a-quarter-of-this-national-park-is-covered-in-glaciers\" target=\"_blank\" dir=\"ltr\">Glacier Bay National Park and Reserve<\/a>, Alaska"},"type":"h2","style":{}},{"id":"5f26f0d4-21e0-493a-81c6-8e36e87872fc","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html73","cntnt":{"mrkup":"A humpback whale breaches the waters of Icy Strait. The National Park Service has monitored whale populations in&nbsp;Glacier Bay&nbsp;since 1985.&nbsp;"},"type":"p","style":{}},{"id":"html74","cntnt":{"mrkup":"35.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/kenai-fjords-national-park\" target=\"_blank\" dir=\"ltr\">Kenai Fjords National Park<\/a>, Alaska"},"type":"h2","style":{}},{"id":"e973284e-ce13-49c5-884b-121da8b07194","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html75","cntnt":{"mrkup":"Glaciers, earthquakes, and ocean storms have shaped Alaska’s&nbsp;Kenai Fjords&nbsp;for centuries, resulting in constantly changing terrain.&nbsp;"},"type":"p","style":{}},{"id":"html76","cntnt":{"mrkup":"36.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/voyageurs-national-park\" target=\"_blank\" dir=\"ltr\">Voyageurs National Park<\/a>, Minnesota"},"type":"h2","style":{}},{"id":"cd8cd525-22ce-4400-bfbb-d9fb69aaf50d","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html77","cntnt":{"mrkup":"Voyageurs National Park&nbsp;is a watery wonderland, with more than a third of its area composed of lakes—and with all of its 200-plus campsites accessible only by boat."},"type":"p","style":{}},{"id":"html78","cntnt":{"mrkup":"37.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/denali-national-park\" target=\"_blank\" dir=\"ltr\">Denali National Park and Reserve<\/a>, Alaska"},"type":"h2","style":{}},{"id":"222eb9d4-92e8-44fe-a3e1-766733ff442b","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html79","cntnt":{"mrkup":"Larger than the state of New Jersey,&nbsp;Denali National Park and Preserve&nbsp;is a vast wilderness that is mostly untouched by human hands. On a good day, the park’s famous—and often notorious—clouds will part to reveal the great massif of Denali, the tallest peak in North America at 20,310 feet high.&nbsp;"},"type":"p","style":{}},{"id":"html80","cntnt":{"mrkup":"38.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/katmai-national-park\" target=\"_blank\" dir=\"ltr\">Katmai National Park<\/a>, Alaska"},"type":"h2","style":{}},{"id":"98fff120-5a90-4e95-b012-870d629dcb13","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html81","cntnt":{"mrkup":"A brown bear (nicknamed “Uno” for her one ear) and her two cubs walk along a river in&nbsp;Katmai National Park and Preserve. Visitors to the park often come in July to watch some 2,000 brown bears grab sockeye salmon around the Brooks Camp waterfall."},"type":"p","style":{}},{"id":"html82","cntnt":{"mrkup":"39.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/wrangell-st-elias-national-park\" target=\"_blank\" dir=\"ltr\">Wrangell St. Elias National Park<\/a>, Alaska"},"type":"h2","style":{}},{"id":"29e3c207-7c00-4f6f-878e-745faa9973be","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html83","cntnt":{"mrkup":"A ring of snow and debris, the remains of an avalanche, surrounds the 125-foot-long, six-mile-long Bagley Icefield in&nbsp;Wrangell St. Elias National Park. To capture its massive scale, Irish took photographs from an airplane."},"type":"p","style":{}},{"id":"html84","cntnt":{"mrkup":"40.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/hot-springs-national-park\" target=\"_blank\" dir=\"ltr\">Hot Springs National Park<\/a>, Arkansas"},"type":"h2","style":{}},{"id":"d3c8fe85-2651-4425-b89d-95e6480f1e1e","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html85","cntnt":{"mrkup":"Hot Springs&nbsp;encompasses both creek-filled wilderness and the grand Bathhouse Row, where eight spa buildings erected between 1892 and 1923 remain."},"type":"p","style":{}},{"id":"html86","cntnt":{"mrkup":"41.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/article/travel-to-canyonlands-in-utah-to-see-the-power-of-the-threatened-colorado-river\" target=\"_blank\" dir=\"ltr\">Canyonlands National Park<\/a>, Utah"},"type":"h2","style":{}},{"id":"bee7cd73-75cd-40f6-8d4d-4c1501a04a9a","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html87","cntnt":{"mrkup":"The sun peeks through Mesa Arch in&nbsp;Canyonlands National Park. The largest and most undeveloped of Utah’s national parks, Canyonlands offers backcountry adventures, scenic landscapes, and two major rivers.&nbsp;"},"type":"p","style":{}},{"id":"html88","cntnt":{"mrkup":"42.&nbsp;<a href=\"http://nationalgeographic.com/travel/national-parks/article/kobuk-valley-national-park\" target=\"_blank\" dir=\"ltr\">Kobuk Valley National Park<\/a>, Alaska"},"type":"h2","style":{}},{"id":"50111a6e-f15f-4539-a0eb-11e15a176264","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html89","cntnt":{"mrkup":"Located in the Arctic region of northwestern Alaska,&nbsp;Kobuk Valley National Park spans a migratory route for more than half a million caribou.&nbsp;"},"type":"p","style":{}},{"id":"html90","cntnt":{"mrkup":"43.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/rocky-mountain-national-park\" target=\"_blank\" dir=\"ltr\">Rocky Mountain National Park<\/a>, Colorado"},"type":"h2","style":{}},{"id":"f31cc3f9-1461-4ed6-846f-973e79cba065","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html91","cntnt":{"mrkup":"A two-hour drive north of Denver, Colorado,&nbsp;Rocky Mountain National Park’s unrivaled stretch of craggy, snow-capped peaks and 355 miles of hiking trails attract more than 4 million visitors annually.&nbsp;"},"type":"p","style":{}},{"id":"html92","cntnt":{"mrkup":"44.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/article/photos-of-gates-of-the-arctic-national-park\" target=\"_blank\" dir=\"ltr\">Gates of the Arctic National Park<\/a>, Alaska"},"type":"h2","style":{}},{"id":"1fb49e3c-e935-4f7b-8e78-4191788fbe2e","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html93","cntnt":{"mrkup":"Situated entirely north of the Arctic Circle in Alaska,&nbsp;Gates of the Arctic National Park and Preserve&nbsp;is the northernmost national park in the U.S. Planning ahead is essential: there are no roads, no trails, and no campsites. Cell phones won’t work."},"type":"p","style":{}},{"id":"html94","cntnt":{"mrkup":"45.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/lake-clark-national-park\" target=\"_blank\" dir=\"ltr\"><b>Lake Clark National Park<\/b><\/a><b>, Alaska<\/h2>"},"type":"h2","style":{}},{"id":"a78711b8-5a78-4cfa-8ead-0dc1b21e594f","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html95","cntnt":{"mrkup":"Roughly 120 air miles southwest of Anchorage,&nbsp;Lake Clark National Park and Preserve, is home to volcanoes, rugged mountains, and salmon-filled waters."},"type":"p","style":{}},{"id":"html96","cntnt":{"mrkup":"46.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/article/uncovering-native-history-in-badlands-national-park\" target=\"_blank\" dir=\"ltr\">Badlands National Park<\/a>, South Dakota"},"type":"h2","style":{}},{"id":"3b29ec16-10b1-4870-93a0-e798e97bac7d","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html97","cntnt":{"mrkup":"Badlands National Park&nbsp;is made up of jagged and striped rock formations. Before it was seized by the U.S. government in the 1920s, the land was inhabited and seen as sacred by the Oglala Lakota Sioux tribe.&nbsp;"},"type":"p","style":{}},{"id":"html98","cntnt":{"mrkup":"47.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/glacier-national-park\" target=\"_blank\" dir=\"ltr\">Glacier National Park<\/a>, Montana"},"type":"h2","style":{}},{"id":"3836348e-11c4-402c-93b9-9949485bff09","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html99","cntnt":{"mrkup":"A quick stop off of the famed Going-to-the-Sun Road brings visitors to one of the most popular stops in the park—the view of St. Mary Lake from Wild Goose Scenic Viewpoint. Together with Waterton Lakes National Park in Canada,&nbsp;Glacier National Park&nbsp;makes up the world’s first international peace park.&nbsp;"},"type":"p","style":{}},{"id":"html100","cntnt":{"mrkup":"48.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/article/beautiful-photos-of-black-canyon-of-the-gunnison\" target=\"_blank\" dir=\"ltr\">Black Canyon of the Gunnison National Park<\/a>, Colorado"},"type":"h2","style":{}},{"id":"1bb99244-e9a7-4417-b242-475a7ba2f1c9","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html101","cntnt":{"mrkup":"Black Canyon of the Gunnison’s 2,250-foot-tall Painted Wall, Colorado’s tallest cliff, is a spectacle of pink granite bands slashing through dark metamorphic rock that are nearly two billion years old.&nbsp;"},"type":"p","style":{}},{"id":"html102","cntnt":{"mrkup":"49.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/hawaii-volcanoes-national-park\" target=\"_blank\" dir=\"ltr\">Hawai’i Volcanoes National Park<\/a>, Hawai’i"},"type":"h2","style":{}},{"id":"e9df012b-5fb2-430f-81cf-f2a800353106","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html103","cntnt":{"mrkup":"Two active volcanoes are within the bounds of&nbsp;this national park, Kilauea being one of the world’s most active. In 2018, Mount Kīlauea’s continued eruptions destroyed approximately 600 homes, as well as roads, farms, and ranches, on the Island of Hawaiʻi."},"type":"p","style":{}},{"id":"html104","cntnt":{"mrkup":"50.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/mesa-verde-national-park\" target=\"_blank\" dir=\"ltr\">Mesa Verde National Park<\/a>, Colorado"},"type":"h2","style":{}},{"id":"52b1a901-558e-45ba-be2b-64cd56f769a2","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html105","cntnt":{"mrkup":"The sun sets early on Cliff Palace, the largest of the ancient stone-and-mortar cliff houses tucked into the&nbsp;park’s canyon walls. The only way to experience the fine detail of the construction is on a ranger-guided tour."},"type":"p","style":{}},{"id":"html106","cntnt":{"mrkup":"51.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/theodore-roosevelt-national-park\" target=\"_blank\" dir=\"ltr\">Theodore Roosevelt National Park<\/a>, North Dakota"},"type":"h2","style":{}},{"id":"d057f94e-78b3-4ed1-abaa-f69477cb472b","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html107","cntnt":{"mrkup":"The Cannonball Concretions, unusual stone formations in the North Unit of&nbsp;the park, can be seen a short drive from the Juniper Campground."},"type":"p","style":{}},{"id":"html108","cntnt":{"mrkup":"52.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/haleakala-national-park\" target=\"_blank\" dir=\"ltr\">Haleakalā National Park<\/a>, Hawai’i"},"type":"h2","style":{}},{"id":"4a5f50a4-0908-4d84-8bf6-16471d148446","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html109","cntnt":{"mrkup":"Haleakalā, which means “house of the sun” in Hawaiian, is one of the world’s largest volcanic craters and is a United Nations International Biosphere Reserve.&nbsp;"},"type":"p","style":{}},{"id":"html110","cntnt":{"mrkup":"53.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/article/capital-reef-national-park-utah-activities\" target=\"_blank\" dir=\"ltr\">Capitol Reef National Park<\/a>, Utah"},"type":"h2","style":{}},{"id":"f311af2f-0c3b-490a-8b26-b77e1b0c86aa","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html111","cntnt":{"mrkup":"Escape the crowds&nbsp;by fording the shallow Fremont River (high-clearance vehicles only) and head out on a 58-mile dirt road loop into desolate Cathedral Valley, an austere landscape dominated by two sandstone sentinels, Temple of the Sun and Temple of the Moon."},"type":"p","style":{}},{"id":"html112","cntnt":{"mrkup":"54.&nbsp;<a href=\"http://nationalgeographic.com/travel/national-parks/article/american-samoa-national-park\" target=\"_blank\" dir=\"ltr\">National Park of American Samoa<\/a>, American Samoa"},"type":"h2","style":{}},{"id":"08735a77-9699-4d36-a791-edbfea7bc816","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html113","cntnt":{"mrkup":"Often overlooked,&nbsp;National Park of American Samoa&nbsp;(on U.S. territory) comprises 10 volcanic islands (five inhabited), five distinct rainforest communities, and two coral atolls (one inhabited)."},"type":"p","style":{}},{"id":"html114","cntnt":{"mrkup":"55.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/channel-islands-national-park\" target=\"_blank\" dir=\"ltr\"><b>Channel Islands National Park<\/b><\/a><b>, California<\/h2>"},"type":"h2","style":{}},{"id":"ee67b9c4-7a36-4f26-972f-6a73b1beea1f","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html115","cntnt":{"mrkup":"Santa Cruz Island (seen in the distance) is one of five isolated islands, along with 1,252 square nautical miles of surrounding sea, protected in&nbsp;this park.&nbsp;"},"type":"p","style":{}},{"id":"html116","cntnt":{"mrkup":"56.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/lassen-volcanic-national-park\" target=\"_blank\" dir=\"ltr\">Lassen Volcanic National Park<\/a>, California"},"type":"h2","style":{}},{"id":"0efc55ed-d44d-4a92-a57f-89a75049e4a0","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html117","cntnt":{"mrkup":"From 1914 to early 1915,&nbsp;Lassen Peak&nbsp;spewed steam and ashes in more than 150 eruptions. Now, the quieted volcano serves as a scenic backdrop to the park’s jigsaw-puzzle landscape of forest, lava beds, and lakes.&nbsp;"},"type":"p","style":{}},{"id":"html118","cntnt":{"mrkup":"57.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/pinnacles-national-park\" target=\"_blank\" dir=\"ltr\">Pinnacles National Park<\/a>, California"},"type":"h2","style":{}},{"id":"e210ad3c-e36b-45df-b000-4b0df2a046e5","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html119","cntnt":{"mrkup":"Known for its spectacular rock formations, beautiful spring wildflowers, and large groups of endangered condors,&nbsp;Pinnacles National Park&nbsp;is a mecca for rock climbing and day hiking. It offers 32 miles of trails that climb through winding talus caves and shaded creeks.&nbsp;"},"type":"p","style":{}},{"id":"html120","cntnt":{"mrkup":"58.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/wind-cave-national-park\" target=\"_blank\" dir=\"ltr\">Wind Cave National Park<\/a>, South Dakota"},"type":"h2","style":{}},{"id":"120eab8b-734d-4d8e-aef9-27b631e57736","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html121","cntnt":{"mrkup":"With 130 miles of explored passages,&nbsp;Wind Cave National Park&nbsp;is among the world’s longest cave systems and a popular spot for spelunking enthusiasts."},"type":"p","style":{}},{"id":"html122","cntnt":{"mrkup":"59.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/article/indiana-dunes-national-park-first-year-open-coronavirus-crowds\" target=\"_blank\" dir=\"ltr\">Indiana Dunes National Park<\/a>, Indiana"},"type":"h2","style":{}},{"id":"ecc91763-c982-4d9c-8a69-b955fdf7cf53","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html123","cntnt":{"mrkup":"The&nbsp;park’s 15 miles of Lake Michigan beaches give way to impressive dunes, and blowouts, marshes, wetlands, and groves of black oak savanna and maple sugar trees. It became a national park in 2019."},"type":"p","style":{}},{"id":"html124","cntnt":{"mrkup":"60.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/gateway-arch-guide-what-to-do-when-to-go\" target=\"_blank\" dir=\"ltr\">Gateway Arch National Park<\/a>, Missouri"},"type":"h2","style":{}},{"id":"3104d3d2-c2ce-423e-a63b-493cb6c49346","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html125","cntnt":{"mrkup":"Gateway Arch National Park&nbsp;has been many things: a monument to Thomas Jefferson’s historic frontier, a commemoration of Lewis and Clark’s epic expedition—and, most recently, the U.S.’s 60th national park.&nbsp;"},"type":"p","style":{}},{"id":"html126","cntnt":{"mrkup":"61.&nbsp;<a href=\"https://www.nps.gov/neri/index.htm\" target=\"_blank\" dir=\"ltr\">New River Gorge National Park and Preserve<\/a>, West Virginia"},"type":"h2","style":{}},{"id":"90644938-48b5-4556-a76c-2c874e24f496","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html127","cntnt":{"mrkup":"New River Gorge National Park and Preserve&nbsp;spans more than 72,000 acres of wooded hills, deep ravines, and the Appalachian plateau. It was named the U.S.’s newest national park in 2020.&nbsp;"},"type":"p","style":{}},{"id":"html128","cntnt":{"mrkup":"62.&nbsp;<a href=\"https://www.nps.gov/whsa/index.htm\" target=\"_blank\" dir=\"ltr\">White Sands National Park<\/a>, New Mexico"},"type":"h2","style":{}},{"id":"5a642dd7-f329-446f-a47d-db52ef5a48a7","cntnt":{"cmsType":"image","ariaLabel":"image","align":"browserWidth","belowHeader":true,"envNme":"prod","flags":{"hideTitle":true},"qryStr":"forceMode=fitt","mrkup":"","placement":"inline"},"type":"inline","style":{}},{"id":"html129","cntnt":{"mrkup":"White Sands National Park&nbsp;protects the largest gypsum dune on Earth, a remnant of bygone lakes and seas, a 275-square-mile basin that glitters white and stays cool to the touch. Visitors come to cruise the eight-mile Dunes Drive, hike one of the five established trails, or see the soft, translucent sand glow blue-white under a full moon.&nbsp;"},"type":"p","style":{}},{"id":"html130","cntnt":{"mrkup":"63.&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/north-cascades-national-park\" target=\"_blank\" dir=\"ltr\">North Cascades National Park<\/a>, Washington"},"type":"h2","style":{}},{"id":"html131","cntnt":{"mrkup":"Less than three hours by car from Seattle or Vancouver,&nbsp;<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/north-cascades-national-park\" target=\"_blank\" dir=\"ltr\">North Cascades National Park<\/a> is home to more than 300 glaciers and over 500 lakes and ponds. Scroll through to discover&nbsp;all the&nbsp;national parks in the United States."},"type":"p","style":{}},{"id":"html132","cntnt":{"mrkup":"(<a href=\"https://www.nationalgeographic.com/travel/national-parks/article/most-visited-parks-photos\" target=\"_blank\" dir=\"ltr\"><i>These are the most popular national parks in the U.S<\/i><\/a>)"},"type":"p","style":{}},{"id":"inline-1","cntnt":{"id":"inline-1","cmsType":"editorsNote","note":"Editor’s note: This story originally published on May 30, 2017, and updated on September 20 to reflect the current number of national parks."},"type":"inline","style":{}},{"id":"inline-2","cntnt":{"id":"inline-2","cmsType":"editorsNote","note":"Jonathan Irish is a professional outdoor and adventure photographer. Follow him on <a href=\"https://www.instagram.com/jonathan_irish/\" target=\"_blank\" dir=\"ltr\">Instagram<\/a> and <a href=\"https://twitter.com/magnumji\" target=\"_blank\" dir=\"ltr\">Twitter<\/a>."},"type":"inline","style":{}}],"cid":"drn:src:natgeo:unison::prod:218152e4-f9b1-4702-9648-ccf082ec1eea","cntrbGrp":[{"contributors":[{"displayName":"Jonathan Irish"}],"title":"Photographs by","rl":"Photographer"},{"contributors":[{"displayName":"National Geographic Staff"}],"title":"By","rl":"Writer"}],"mode":"richtext","enableAds":true,"endbug":true,"hsImmrsvLd":true,"isMetered":false,"isUserAuthed":false,"isTruncated":false,"isEntitled":false,"freemiumContentGatingEnabled":true,"premiumContentGatingEnabled":false,"mdDt":"2025-09-22T11:00:00.000Z","readTime":"50 min read","schma":{"athrs":[{"name":"National Geographic Staff"}],"cnnicl":"https://www.nationalgeographic.com/travel/article/beautiful-photos-of-all-us-national-parks","kywrds":"national parks, travel photography, photography, united states, jonathan irish, newest national park, what is a national park, how many national parks are there, where to find a national park, Haleakalā national park, new river gorge national park, hawaii volcano national park , best national park, least visited national park, national parks to visit, White Sands National Park, Yellowstone 150th anniversary, Canyonlands National Park, Yosemite National Park , Zion National Park","lg":"https://assets-cdn.nationalgeographic.com/natgeo/static/default.NG.logo.dark.jpg","pblshr":"National Geographic","abt":"National Parks","sclDsc":"From massive glaciers to sun-soaked beaches, national parks offer some of America’s wildest and most iconic landscapes.","sclImg":"https://i.natgeofe.com/n/afed9877-feea-4292-bbc0-d049bab77277/north-cascades-national-park-picture-lake-mount-shuksan_16x9.jpg?w=1200","sclTtl":"See the beauty of all 63 U.S. national parks, in photos"},"sctn":"Travel","wrdcnt":3326,"dt":"2025-09-22T12:00:00","pbDt":"2019-02-28T16:43:00.000Z","prismData":{"mainComponents":[{"name":"Body","props":{"body":[[{"type":"p","content":["When the U.S. Congress established ",{"type":"a","content":["Yellowstone"],"attrs":{"href":"https://www.nationalgeographic.com/travel/article/see-yellowstone-in-iconic-nat-geo-images","target":"_blank","dir":"ltr"}}," as the first national park in 1872, it was “for the benefit and enjoyment of the people.” Its founding marked the birth of the U.S. National Park System and eventually launched a worldwide movement to protect outdoor spaces and historical landmarks. Since 1904, some ",{"type":"a","content":["15 billion visitors"],"attrs":{"href":"https://www.nps.gov/aboutus/visitation-numbers.htm","target":"_blank","dir":"ltr"}}," have explored the wild wonders of the U.S. parks."]},{"type":"p","content":["Inspired by the National Park Service, photographer ",{"type":"a","content":["Jonathan Irish"],"attrs":{"href":"https://www.jonathanirish.com/index/G0000S6QPk7.Al_c","target":"_blank","dir":"ltr"}}," inspired by the visited every ",{"type":"a","content":["U.S. national park"],"attrs":{"href":"https://www.nationalgeographic.com/travel/national-parks/","target":"_blank","dir":"ltr"}}," over 52 weeks."]},{"type":"p","content":["“[National parks] are sacred and cherished places—our greatest personal and national treasures,” says Irish. “It’s a gift to spend a year adventuring and capturing incredible images and stories in some of the most beautiful places on Earth.”"]}],{"type":"inline","content":{"name":"Ad","props":{"ad":{"kvps":{"pos":"fitt-article-inline-outstream-1"},"type":"fitt-article-inline-outstream","className":"fitt-article-inline-outstream"},"className":"natgeo-ad","placeholders":{"compact":{"hideOnRendered":true,"size":[320,50]},"regular":{"hideOnRendered":true,"size":[320,50]}},"initSelf":true},"context":{},"config":{"gridDisplayMode":"none"}}},[{"type":"p","content":["Since Irish’s journey, the National Parks Service has designated four additional parks: the Gateway Arch in St. Louis; Indiana Dunes on Lake Michigan; White Sands in New Mexico; and New River Gorge in West Virginia. There are now 63 spaces to explore across the country."]},{"type":"p","content":["Celebrate the grandeur of these priceless national treasures in images, from the crystalline waters of Dry Tortugas in Florida to the deep, dark recesses of Kentucky’s Mammoth Cave."]},{"type":"h2","content":["1."," ",{"type":"a","content":["Zion National Park"],"attrs":{"href":"https://www.nationalgeographic.com/travel/national-parks/article/zion-national-park","target":"_blank","dir":"ltr"}},", Utah"]},{"type":"inline","content":{"name":"Image","props":{"link":{},"caption":{"title":"","credit":"Photograph by Jonathan Irish","source":"","text":"Watchman at Zion National Park","lines":3,"showMoreText":"Read More","showLess":false},"image":{"id":"Watchman at Zion National Park","showCopyright":"Please be respectful of copyright. Unauthorized use is prohibited.","alt":"View from Canyon Junction Bridge at Zion National Park","src":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg","sources":[{"src":{"x1":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=374&h=249","x2":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=748&h=498"},"max":374,"nativeWidth":374},{"src":{"x1":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=413&h=275","x2":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=826&h=550"},"max":413,"min":375,"nativeWidth":413},{"src":{"x1":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=718&h=479","x2":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=1436&h=958"},"min":414,"nativeWidth":718}],"viewerSources":[{"src":{"x1":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=374&h=249","x2":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=748&h=498"},"max":374,"nativeWidth":374},{"src":{"x1":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=413&h=275","x2":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=826&h=550"},"max":413,"min":375,"nativeWidth":413},{"src":{"x1":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=767&h=511","x2":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=1534&h=1022"},"max":767,"min":414,"nativeWidth":767},{"src":{"x1":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=1024&h=683","x2":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=2048&h=1366"},"max":1024,"min":768,"nativeWidth":1024},{"src":{"x1":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=1440&h=960&q=90","x2":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=2880&h=1920&q=90"},"max":1440,"min":1025,"nativeWidth":1440},{"src":{"x1":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=1920&h=1280&q=90","x2":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=3840&h=2560&q=90"},"max":1920,"min":1441,"nativeWidth":1920},{"src":{"x1":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=2500&h=1667&q=90","x2":"https://i.natgeofe.com/n/40c8ec76-10ca-483d-9a78-aa7d75e12150/zion-national-park-canyon-junction-bridge.jpg?w=5000&h=3334&q=90"},"min":1921,"nativeWidth":2500}]},"disableFullscreen":false},"context":{},"config":{"align":"full","alignXxs":"full"}}},{"type":"p","content":[" ","One of the most photographed views in"," ","Zion National Park"," ","is of Watchman Mountain from the Canyon Junction Bridge. Irish’s favorite spot is at the center of the bridge where the river leads the eye to the Watchman Spire in the background."]},{"type":"h2","content":["2."," ",{"type":"a","content":["Yellowstone National Park,"],"attrs":{"href":"https://www.nationalgeographic.com/travel/national-parks/article/yellowstone-national-park","target":"_blank","dir":"ltr"}}," ","Wyoming, Montana, and Idaho"]}],{"type":"inline","content":{"name":"Image","props":{"link":{},"caption":{"title":"","credit":"Photograph by Jonathan Irish","source":"","text":"The Great Fountain Geyser in Yellowstone National Park, Wyoming","lines":3,"showMoreText":"Read More","showLess":false},"image":{"id":"The Great Fountain Geyser in Yellowstone National Park, Wyoming","showCopyright":"Please be respectful of copyright. Unauthorized use is prohibited.","alt":"the Great Fountain Geyser in Yellowstone National Park, Wyoming","src":"https://i.natgeofe.com/n/bb6c6e87-712f-4668-8765-3c607a813597/yellowstone-national-park-great-fountain-geyser.jpg","sources":[{"src":{"x1":"https://i.natgeofe.com/n/bb6c6e87-712f-4668-8765-3c607a813597/yellowstone-national-park-great-fountain-geyser.jpg?w=374&h=249","x2":"https://i.natgeofe.com/n/bb6c6e87-712f-4668-8765-3c607a813597/yellowstone-national-park-great-fountain-geyser.jpg?w=748&h=498"},"max":374,"nativeWidth":374},{"src":{"x1":"https://i.natgeofe.com/n/bb6c6e87-712f-4668-8765-3c607a813597/yellowstone-national-park-great-fountain-geyser.jpg?w=413&h=275","x2":"https://i.natgeofe.com/n/bb6c6e87-712f-4668-8765-3c607a813597/yellowstone-national-park-great-fountain-geyser.jpg?w=826&h=550"},"max":413,"min":375,"nativeWidth":413},{"src":{"x1":"https://i.natgeofe.com/n/bb6c6e87-712f-4668-8765-3c607a813597/yellowstone-national-park-great-fountain-geyser.jpg?w=767&h=511","x2":"https://i.natgeofe.com/n/bb6c6e87-712f-4668-8765-3c607a813597/yellowstone-national-park-great-fountain-geyser.jpg?w=1534&h=1022"},"max":767,"min":414,"nativeWidth":767},{"src":{"x1":"https://i.natgeofe.com/n/bb6c6e87-712f-4668-8765-3c607a813597/yellowstone-national-park-great-fountain-geyser.jpg?w=1024&h=683","x2":"https://i.natgeofe.com/n/bb6c6e87-712f-4668-8765-3c607a813597/yellowstone-national-park-great-fountain-geyser.jpg?w=2048&h=1366"},"max":1024,"min":768,"nativeWidth":1024},{"src":{"x1":"https://i.natgeofe.com/n/bb6c6e87-712f-4668-8765-3c607a813597/yellowstone-national-park-great-fountain-geyser.jpg?w=1440&h=960&q=90","x2":"https://i.natgeofe.com/n/bb6c6e87-712f-4668-8765-3c607a813597/yellowstone-national-park-great-fountain-geyser.jpg?w=2880&h=1920&q=90"},"max":1440,"min":1025,"nativeWidth":1440},{"src":{"x1":"https://i.natgeofe.com/n/bb6c6e87-712f-4668-8765-3c607a813597/yellowstone-national-park-great-fountain-geyser.jpg?w=1920&h=1280&q=90","x2":"https://i.natgeofe.com/n/bb6c6e87-712f-4668-8765-3c607a813597/yellowstone-national-park-great-fountain-geyser.jpg?w=3840&h=2560&q=90"},"max":1920,"min":1441,"nativeWidth":1920},{"src":{"x1":"https://i.natgeofe.com/n/bb6c6e87-712f-4668-8765-3c607a813597/yellowstone-national-park-great-fountain-geyser.jpg?w=2500&h=1667&q=90","x2":"https://i.natgeofe.com/n/bb6c6e87-712f-4668-8765-3c607a813597/yellowstone-national-park-great-fountain-geyser.jpg?w=5000&h=3334&q=90"},"min":1921,"nativeWidth":2500}]},"ratio":"3000x2000","disableFullscreen":false},"context":{},"config":{"align":"full","alignXxs":"full","gridDisplayMode":"none"}}},[{"type":"p","content":["America’s first national park,"," ","Yellowstone"," ","is home to wildlife from bears to bison and geological stunners such as hot springs and geysers. The Great Fountain Geyser, pictured here, erupts every 9 to 15 hours, shooting water up to 220 feet (67 meters) high."]},{"type":"h2","content":["3."," ",{"type":"a","content":["Acadia National Park"],"attrs":{"href":"https://www.nationalgeographic.com/travel/national-parks/article/acadia-national-park","target":"_blank","dir":"ltr"}},", Maine"]}],{"type":"inline","content":{"name":"Image","props":{"link":{},"caption":{"title":"","credit":"Photograph by Jonathan Irish","source":"","text":"Bass Harbor Lighthouse in Acadia National Park, Maine","li